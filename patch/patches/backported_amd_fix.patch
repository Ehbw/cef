@@ -86,6 +86,19 @@ DXGISharedHandleState::DXGISharedHandleState(
 }
 
 DXGISharedHandleState::~DXGISharedHandleState() {
+  {
+    // Flush each device context to ensure drivers process deferred destruction
+    // of shared textures promptly (fixes VRAM leak observed on AMD hardware
+    // when shared handles are closed without a flush).
+    base::AutoLock auto_lock(lock_);
+    for (auto& entry : d3d11_texture_state_map_) {
+      Microsoft::WRL::ComPtr<ID3D11DeviceContext> context;
+      entry.first->GetImmediateContext(&context);
+      if (context) {
+        context->Flush();
+      }
+    }
+  }
   CHECK(!keyed_mutex_acquired_);
 }
 
